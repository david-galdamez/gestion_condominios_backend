# Entorno de pruebas e2e. Copiar a .env.test (ignorado por git).
# Base separada de la de desarrollo: los e2e hacen TRUNCATE de las tablas.
NODE_ENV=test
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/condominios_test?schema=public
JWT_SECRET=secreto-solo-para-pruebas-e2e-0123456789abcdef
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
# Costo mínimo para que el login real no vuelva lentas las pruebas.
BCRYPT_SALT_ROUNDS=4
